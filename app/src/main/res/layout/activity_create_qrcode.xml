<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Toolbar 固定在顶部，不随内容滚动 -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        app:popupTheme="@style/ToolbarPopupTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:titleTextColor="@android:color/white"
        android:background="@color/colorAccent"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/create_input_hint">

                <requestFocus />
            </EditText>

            <Button
                android:id="@+id/btnCreate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/create_btn_generate" />

            <!-- Logo 上传入口：常驻显示，选中的 Logo 预览显示在按钮右侧（与按钮同高） -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnPickLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/create_pick_logo" />

                <ImageView
                    android:id="@+id/imgLogoPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="8dp"
                    android:adjustViewBounds="true"
                    android:maxWidth="96dp"
                    android:contentDescription="@string/create_pick_logo"
                    android:scaleType="centerInside"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 一维码行：码在左，标签与保存按钮在右（生成成功后才显示） -->
            <LinearLayout
                android:id="@+id/rowBarcode"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgBarcode"
                    android:layout_width="220dp"
                    android:layout_height="110dp"
                    android:contentDescription="@string/create_label_barcode"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_label_barcode"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnSaveBarcode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_save" />
                </LinearLayout>
            </LinearLayout>

            <!-- 基础二维码行（生成成功后才显示） -->
            <LinearLayout
                android:id="@+id/rowBasic"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgBasic"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:contentDescription="@string/create_label_basic"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_label_basic"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnSaveBasic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_save" />
                </LinearLayout>
            </LinearLayout>

            <!-- 自定义边距二维码行（生成方式参考 AboutActivity，生成成功后才显示） -->
            <LinearLayout
                android:id="@+id/rowPadding"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgPadding"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:contentDescription="@string/create_label_padding"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_label_padding"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnSavePadding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_save" />
                </LinearLayout>
            </LinearLayout>

            <!-- 带 Logo 二维码行（生成方式参考 AboutActivity，生成成功后才显示） -->
            <LinearLayout
                android:id="@+id/rowLogo"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:contentDescription="@string/create_label_logo"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_label_logo"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnSaveLogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/create_save" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
